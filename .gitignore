# Statik Netlify/demo iskeleti: site/kojo.js `sbt fullLinkJS` ÇIKTISI, kaynak
# değil. İki kez `git add -A` ile kazara commit'lendi. Yeniden üretmek için
# (Scala.js 1.x çıktı düzeni):
#   sbt fullLinkJS && cp target/scala-2.12/kojo-dev-opt/main.js site/kojo.js
site/
netlify.toml
__pycache__/

# test-tarayici.sh'ın indirdiği chromedriver'lar (sürüm başına bir dizin)
.chromedriver/

# CI'nın kapsam denetimi için yan yana klonladığı kojo deposu
# (araclar/sozluk-kapsam-denetle.py dict.scala'yı oradan okuyor).
# Çalışma ağacında durursa "üretilenler ağaçtakiyle aynı mı" adımı
# kırmızı yanar -- o adım izlenmeyen dosyaları BİLEREK görüyor.
kojo-kaynak/

# CI'nın gezinti şeridi denetimi için yan yana klonladığı kojojs-editor
# (araclar/gezinti-denetle.py --editor kojojs-editor; #151). kojo-kaynak/ ile
# aynı sebep: izlenmezse "üretilenler ağaçtakiyle aynı mı" adımı kırmızı yanar.
kojojs-editor/
